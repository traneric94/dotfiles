{
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "bash ~/.codex/hooks/notify.sh permission",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "bash ~/.codex/hooks/notify.sh compact",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash '/Users/eric.tran/.codex/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "bash ~/.codex/hooks/notify.sh stop",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "bash ~/.codex/hooks/notify.sh prompt",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ]
  }
}