# Keys documented in HOTKEYS.md (repo root); update it when changing a binding.
# Ghostty configuration — Catppuccin Mocha, Hack Nerd Font, transparent

# Font
font-family = "Hack Nerd Font Mono"
font-size = 14

# Theme — built-in
theme = "Catppuccin Mocha"

# Window
background-opacity = 0.80
background-blur-radius = 20
macos-titlebar-style = hidden
window-save-state = always
window-inherit-working-directory = true

# Scrollback
scrollback-limit = 10000000

# herdr owns workspaces, tabs, and splits; every Ghostty window attaches to the persistent herdr server.
# The server starts in ~/codebase on first launch and survives Ghostty quitting.
command = /bin/bash --noprofile --norc -c 'cd "$HOME/codebase" && exec /opt/homebrew/bin/herdr'

# Shell — auto-injected for zsh
shell-integration = zsh
shell-integration-features = cursor,sudo,title

# macOS Option key — forwards as Alt/Meta to terminal apps (herdr, nvim)
macos-option-as-alt = true

# Bell — visual only, no audio
bell-features = no-system,no-audio,attention,title

# Cursor
cursor-style = block
cursor-style-blink = false

# Keybinds — Cmd+C/V, Cmd+T/N/W, Cmd+/-/0 are all default in Ghostty
# Vi-mode toggle equivalent: Ghostty has scrollback search via cmd+f

# Dump terminal output to a temp file and paste the path into the prompt.
# Pair with the `sb` zsh alias: opens the most recent dump in nvim.
keybind = cmd+shift+j=write_scrollback_file:paste
keybind = cmd+shift+s=write_screen_file:paste
keybind = cmd+shift+u=write_selection_file:paste

# Native-feeling herdr: Cmd shortcuts send the herdr prefix (C-b = \x02) + key
keybind = cmd+t=text:\x02c
keybind = cmd+d=text:\x02v
keybind = cmd+shift+d=text:\x02-
keybind = cmd+shift+left_bracket=text:\x02p
keybind = cmd+shift+right_bracket=text:\x02n
keybind = cmd+one=text:\x021
keybind = cmd+two=text:\x022
keybind = cmd+three=text:\x023
keybind = cmd+four=text:\x024
keybind = cmd+five=text:\x025
keybind = cmd+six=text:\x026
keybind = cmd+seven=text:\x027
keybind = cmd+eight=text:\x028
keybind = cmd+nine=text:\x029
