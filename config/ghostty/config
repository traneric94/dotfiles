# Keys documented in HOTKEYS.md (repo root); update it when changing a binding.
# Ghostty configuration — Catppuccin Mocha, Hack Nerd Font, transparent

# Font
font-family = "Hack Nerd Font Mono"
font-size = 14

# Theme — built-in
theme = "Catppuccin Mocha"

# Window
background-opacity = 0.80
background-blur-radius = 20
macos-titlebar-style = hidden
window-save-state = always
window-inherit-working-directory = true

# Scrollback
scrollback-limit = 10000000

# tmux owns sessions, windows, and splits; every Ghostty window starts its own session in ~/codebase.
# First window creates session "main"; later windows get a fresh auto-named session.
command = /bin/bash --noprofile --norc -c 'if /opt/homebrew/bin/tmux has-session -t "=main" 2>/dev/null; then exec /opt/homebrew/bin/tmux new-session -c "$HOME/codebase"; else exec /opt/homebrew/bin/tmux new-session -s main -c "$HOME/codebase"; fi'

# Shell — auto-injected for zsh
shell-integration = zsh
shell-integration-features = cursor,sudo,title

# macOS Option key — forwards as Alt/Meta to terminal apps (tmux, nvim)
macos-option-as-alt = true

# Bell — visual only, no audio
bell-features = no-system,no-audio,attention,title

# Cursor
cursor-style = block
cursor-style-blink = false

# Keybinds — Cmd+C/V, Cmd+T/N/W, Cmd+/-/0 are all default in Ghostty
# Vi-mode toggle equivalent: Ghostty has scrollback search via cmd+f

# Dump terminal output to a temp file and paste the path into the prompt.
# Pair with the `sb` zsh alias: opens the most recent dump in nvim.
keybind = cmd+shift+j=write_scrollback_file:paste
keybind = cmd+shift+s=write_screen_file:paste
keybind = cmd+shift+u=write_selection_file:paste

# Native-feeling tmux: Cmd shortcuts send the tmux prefix (C-a = \x01) + key
keybind = cmd+t=text:\x01c
keybind = cmd+d=text:\x01v
keybind = cmd+shift+d=text:\x01h
keybind = cmd+shift+left_bracket=text:\x01p
keybind = cmd+shift+right_bracket=text:\x01n
keybind = cmd+one=text:\x011
keybind = cmd+two=text:\x012
keybind = cmd+three=text:\x013
keybind = cmd+four=text:\x014
keybind = cmd+five=text:\x015
keybind = cmd+six=text:\x016
keybind = cmd+seven=text:\x017
keybind = cmd+eight=text:\x018
keybind = cmd+nine=text:\x019
